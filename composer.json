{
  "name": "olajideolamide/dex",
  "description": "Open-source monitoring for CodeIgniter 4",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "codeigniter4/framework": "^4.5 || ^4.6",
    "ext-mbstring": "*"
  },
  "autoload": {
    "psr-4": {
      "Dex\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Dex\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit -c phpunit.xml.dist",
    "test:sqlite": "DB=SQLite3 phpunit -c phpunit.xml.dist",
    "test:mysql": "DB=MySQLi phpunit -c phpunit.xml.dist",
    "test:coverage": "phpunit -c phpunit.xml.dist --coverage-text",
    "test:unit": "phpunit -c phpunit.xml.dist --group unit",
    "test:database": "phpunit -c phpunit.xml.dist --group database",
    "test:feature": "phpunit -c phpunit.xml.dist --group feature",
    "test:journey": "phpunit -c phpunit.xml.dist --group journey",
    "test:lifecycle": "phpunit -c phpunit.xml.dist --group lifecycle",
    "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=1G",
    "phpcs": "php tools/qa/run-phpcs-changed.php",
    "phpcs:all": "phpcs --standard=phpcs.xml.dist --colors",
    "phpcbf": "phpcbf --standard=phpcs.xml.dist --colors",
    "qa": [
      "@phpstan",
      "@test"
    ],
    "qa:full": [
      "@phpstan",
      "@phpcs",
      "@test"
    ]
  },
  "require-dev": {
    "codeigniter/phpstan-codeigniter": "^1.3",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
