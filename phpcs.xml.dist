<?xml version="1.0"?>
<ruleset name="Dex">
    <description>Dex coding standard configuration.</description>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="warning-severity" value="0"/>

    <file>src</file>
    <file>tests</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/var/*</exclude-pattern>

    <rule ref="PSR12"/>
</ruleset>
